MOCK_MODE=true
# Optional Sepolia browser RPC. Leave blank for the chain's default public RPC.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:42069
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=
WORLD_API_KEY=
# Reserved for genuine World onboarding; keys alone do not implement the SDK flow.
# Visitors never supply these secrets through the public website.

# Public deployments automatically show recorded data until these live settings exist.
# Set DEMO_SNAPSHOT_MODE=true to explicitly keep recorded mode.
DEMO_SNAPSHOT_MODE=
INDEXER_URL=
PROTOCOL_RPC_URL=
# JSON containing chainId=11155111, startBlock, registry, manager, token, oracle, identity, rpc.
# Use actual deployed Sepolia contracts; never the local deployment's addresses.
PROTOCOL_DEPLOYMENT_JSON=
